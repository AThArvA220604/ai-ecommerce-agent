# AI E-commerce Automation Agent — Environment Configuration

# ─── Database ──────────────────────────────────────────────────────────────
# Local dev uses SQLite. Postgres swap-in is prepped but not yet wired.
DB_PATH=ecommerce.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ecommerce

# ─── AI Engine ─────────────────────────────────────────────────────────────
# USE_LLM=true AND a valid OPENAI_API_KEY → system runs in LLM mode.
# Either missing → system runs in rule-based fallback mode (honest default).
USE_LLM=false
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=10.0
OPENAI_MAX_RETRIES=2

# Circuit breaker: after N consecutive LLM failures, fail fast for M seconds
# and fall back to rules. Prevents hammering a broken API.
LLM_FAILURE_THRESHOLD=3
LLM_COOLDOWN_SECONDS=60

# ─── SMTP (simulated in dev) ───────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@ecommerce.ai
# SMTP_PASSWORD=app-password-here
# ALERT_RECIPIENTS=ops@ecommerce.ai,manager@ecommerce.ai

# ─── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ─── Frontend ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api

